@@ -0,0 +1,25 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+const mock = vi.hoisted(() => ({ moderate: vi.fn(), english: vi.fn() }));
+vi.mock('../../settings/cs114-demo', () => ({ CS114_DEMO: { forceVietnamese: true } }));
+vi.mock('../cs114-space', () => ({ moderateCs114: mock.moderate }));
+vi.mock('../en-space', () => ({ moderateEnglish: mock.english }));
+import { moderateText } from '../index';
+
+describe('CS114 demo routing', () => {
+  beforeEach(() => { mock.moderate.mockReset(); mock.english.mockReset(); });
+  it('routes Vietnamese without diacritics to the configured demo', async () => {
+    mock.moderate.mockResolvedValue({ flagged: false, isHarmful: false });
+    await moderateText('hom nay troi dep qua');
+    expect(mock.moderate).toHaveBeenCalledWith('hom nay troi dep qua');
+    expect(mock.english).not.toHaveBeenCalled();
+  });
+  it('keeps the pure-model result even when a legacy lexicon term is present', async () => {
+    const result = { flagged: false, isHarmful: false };
+    mock.moderate.mockResolvedValue(result);
+    expect(await moderateText('vl')).toBe(result);
+  });
+  it('propagates API failure without a CLEAN result', async () => {
+    mock.moderate.mockRejectedValue(new Error('Space unavailable'));
+    await expect(moderateText('kiem thu')).rejects.toThrow('Space unavailable');
+  });
+});
