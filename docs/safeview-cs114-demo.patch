+/** Separate research build. Generated from the evaluated release before use. */
+export interface Cs114DemoConfig {
+  spaceUrl: string;
+  modelUrl: string;
+  modelName: string;
+  modelRevision: string;
+  policyVersion: string;
+  threshold: number;
+  forceVietnamese: boolean;
+}
+
+// Null deliberately preserves the existing extension until a real release exists.
+export const CS114_DEMO: Cs114DemoConfig | null = null;
