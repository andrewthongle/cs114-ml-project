@@ -0,0 +1,45 @@
+import { describe, it, expect } from 'vitest';
+import { normaliseCs114Response } from '../cs114-space';
+import type { Cs114DemoConfig } from '../../settings/cs114-demo';
+
+const config: Cs114DemoConfig = {
+  spaceUrl: 'https://fixture.hf.space', modelUrl: 'https://huggingface.co/fixture/model',
+  modelName: 'Synthetic contract fixture', modelRevision: 'fixture-v1', policyVersion: '1',
+  threshold: 0.6, forceVietnamese: true,
+};
+const response = {
+  scores: { CLEAN: 0.4, OFFENSIVE: 0.35, HATE: 0.25 },
+  label: 'CLEAN', confidence: 0.4, p_harm: 0.6, should_hide: true,
+  model_revision: 'fixture-v1', policy_version: '1',
+};
+
+describe('CS114 frozen policy contract', () => {
+  it('hides when combined harmful probability crosses threshold even with CLEAN argmax', () => {
+    const result = normaliseCs114Response(response, config);
+    expect(result.flagged).toBe(true);
+    expect(result.rawLabel).toBe('CLEAN');
+    expect(result.confidence).toBe(0.4);
+    expect(result.pHarm).toBe(0.6);
+    expect(result.categories.CLEAN).toBe(true);
+  });
+  it('preserves a harmful label when the hiding threshold is not met', () => {
+    const result = normaliseCs114Response({ ...response,
+      scores: { CLEAN: 0.3, OFFENSIVE: 0.1, HATE: 0.6 }, label: 'HATE', confidence: 0.6,
+      p_harm: 0.7, should_hide: false,
+    }, { ...config, threshold: 0.8 });
+    expect(result.flagged).toBe(false);
+    expect(result.rawLabel).toBe('HATE');
+  });
+  it('rejects a deployment update rather than assigning the old threshold silently', () => {
+    expect(() => normaliseCs114Response({ ...response, model_revision: 'unexpected' }, config)).toThrow();
+  });
+  it('rejects missing classes and malformed probabilities', () => {
+    for (const scores of [{ CLEAN: 1 }, { CLEAN: NaN, OFFENSIVE: 0.5, HATE: 0.5 },
+      { CLEAN: 0.4, OFFENSIVE: 0.4, HATE: 0.4 }, { CLEAN: 0.4, OFFENSIVE: 0.35, HATE: 0.25, extra: 0 }]) {
+      expect(() => normaliseCs114Response({ ...response, scores }, config)).toThrow();
+    }
+  });
+  it('rejects server/client policy disagreement', () => {
+    expect(() => normaliseCs114Response({ ...response, should_hide: false }, config)).toThrow();
+  });
+});
diff --git a/src/provider/cs114-space.ts b/src/provider/cs114-space.ts
new file mode 100644
--- /dev/null
+++ b/src/provider/cs114-space.ts
@@ -0,0 +1,55 @@
+import { CS114_DEMO, type Cs114DemoConfig } from '../settings/cs114-demo';
+import { HF_TIMEOUT_MS, HF_MAX_RETRIES, HF_RETRY_DELAY_MS } from '../settings/config';
+import { fetchWithRetry } from './fetch-util';
+import type { ModerationResult } from './types';
+
+const LABELS = ['CLEAN', 'OFFENSIVE', 'HATE'] as const;
+type Label = (typeof LABELS)[number];
+
+/** Validate the identity-bearing endpoint while retaining /classify compatibility. */
+export function normaliseCs114Response(raw: unknown, config: Cs114DemoConfig): ModerationResult {
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) throw new Error('Invalid CS114 response');
+  const response = raw as Record<string, unknown>;
+  if (response.model_revision !== config.modelRevision || response.policy_version !== config.policyVersion) {
+    throw new Error('CS114 release identity changed; reload the pinned demo build');
+  }
+  if (!Number.isFinite(config.threshold) || config.threshold < 0 || config.threshold > 1 + Number.EPSILON) {
+    throw new Error('Invalid locked CS114 threshold');
+  }
+  const rawScores = response.scores;
+  if (!rawScores || typeof rawScores !== 'object' || Array.isArray(rawScores)) throw new Error('Invalid CS114 scores');
+  const record = rawScores as Record<string, unknown>;
+  if (Object.keys(record).length !== 3 || !LABELS.every((label) => {
+    const p = record[label];
+    return typeof p === 'number' && Number.isFinite(p) && p >= 0 && p <= 1;
+  })) throw new Error('CS114 requires exactly three normalized probabilities');
+  const scores = record as Record<Label, number>;
+  if (Math.abs(LABELS.reduce((total, name) => total + scores[name], 0) - 1) > 1.01e-6) {
+    throw new Error('CS114 probabilities do not sum to one');
+  }
+  const label = LABELS.reduce<Label>((best, name) => scores[name] > scores[best] ? name : best, 'CLEAN');
+  const pHarm = Math.min(1, scores.OFFENSIVE + scores.HATE);
+  const flagged = pHarm >= config.threshold;
+  if (response.label !== label || response.confidence !== scores[label] ||
+      typeof response.p_harm !== 'number' || Math.abs(response.p_harm - pHarm) > 1e-12 ||
+      response.should_hide !== flagged) throw new Error('CS114 decision does not match the locked policy');
+  return {
+    flagged, isHarmful: flagged,
+    category: label === 'HATE' ? 'hate' : label === 'OFFENSIVE' ? 'offensive' : 'other',
+    // Legacy field only. CS114 UI does not present confidence as severity.
+    severity: 'low', confidence: scores[label],
+    categories: { CLEAN: label === 'CLEAN', OFFENSIVE: label === 'OFFENSIVE', HATE: label === 'HATE' },
+    reason: label, language: 'vi', provider: 'huggingface-vi',
+    rawScores: scores, rawLabel: label, pHarm,
+    modelRevision: config.modelRevision, policyVersion: config.policyVersion,
+  };
+}
+
+export async function moderateCs114(text: string): Promise<ModerationResult> {
+  if (!CS114_DEMO) throw new Error('CS114 demo has no configured release');
+  const raw = await fetchWithRetry(CS114_DEMO.spaceUrl, text, {
+    timeoutMs: HF_TIMEOUT_MS, maxRetries: HF_MAX_RETRIES, retryDelayMs: HF_RETRY_DELAY_MS,
+    apiName: 'decision',
+  });
+  return normaliseCs114Response(raw, CS114_DEMO);
+}
